# Settings for bin/wt, one file per project: copy to projects/<main checkout folder name>.env beside this file (or point WT_CONFIG at another path).

# Database names start with this. The main checkout uses <prefix>_development and <prefix>_test;
# each worktree gets <prefix>_<branch> and <prefix>_test_<branch>.
WT_DB_PREFIX=my_app

# The portless name: the main checkout serves at https://my-app.localhost, a worktree at
# https://<branch>.my-app.localhost
WT_APP=my-app

# Linear team key. With it, `wt new ABC-1234` looks up the issue's branch. Leave empty to turn
# that off.
WT_TICKET_PREFIX=abc

# Every worktree's browser signs in as this user (see app/worktree_auto_login.rb). Defaults to
# your git email.
# WT_AUTO_LOGIN_EMAIL=

# `wt prune` offers to remove a worktree with no PR after this many days without a commit
WT_IDLE_DAYS=14

# Where worktrees go (default: <main checkout's parent>/worktrees/<repo>)
# WT_DIR=

# What opens to the right of the agent in the code layout
# WT_EDITOR=nvim

# Override to use your own copy
# WT_AUTO_LOGIN_SOURCE=$HOME/worktree_auto_login.rb
