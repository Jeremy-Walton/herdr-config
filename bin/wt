#!/usr/bin/env bash
# wt: per-branch git worktrees with their own databases, browser URL, and Herdr space.
# A macOS / Herdr.app port of https://github.com/gavinomelia/herdr-config
set -euo pipefail

SELF=$(readlink "$0" 2>/dev/null || echo "$0")
WT_HOME=$(cd "$(dirname "$SELF")/.." && pwd)
WT_CONFIG=${WT_CONFIG:-$WT_HOME/wt.env}
[ -f "$WT_CONFIG" ] || { echo "wt: no settings at $WT_CONFIG; copy $WT_HOME/wt.env.example there and fill it in" >&2; exit 1; }
# shellcheck source=/dev/null
. "$WT_CONFIG"
DB_PREFIX=${WT_DB_PREFIX:?set WT_DB_PREFIX in $WT_CONFIG}
DEV_DB=${DB_PREFIX}_development
SNAPSHOT_DB=${DB_PREFIX}_snapshot
APP_NAME=${WT_APP:?set WT_APP in $WT_CONFIG}
TICKET_PREFIX=${WT_TICKET_PREFIX:-}
IDLE_DAYS=${WT_IDLE_DAYS:-14}
AUTO_LOGIN_SOURCE=${WT_AUTO_LOGIN_SOURCE:-$WT_HOME/app/worktree_auto_login.rb}
AUTO_LOGIN_TARGET=config/initializers/worktree_auto_login.rb

REVIEW_PROMPT='Review this branch against %s: the committed diff from the merge base plus any uncommitted changes. Another agent wrote it. Apply AGENTS.md and the docs/conventions files that match the changed paths. Do not edit files; running targeted specs is fine. Report findings ranked by severity, each with file:line, the failing scenario, and a suggested fix. If nothing is worth fixing, say so plainly.'
ISSUE_PROMPT='Read Linear issue %s with get_issue and list_comments. Summarize what it asks for and any open questions, then wait for instructions.'
PR_PROMPT='This checkout is PR #%s, here for review. Read it with gh pr view %s and its diff against its base. Summarize what it changes, then wait for instructions.'

die() { echo "wt: $*" >&2; exit 1; }
say() { echo "==> $*"; }
lower() { echo "$1" | tr '[:upper:]' '[:lower:]'; }
upper() { echo "$1" | tr '[:lower:]' '[:upper:]'; }

main_checkout() { git worktree list --porcelain | sed -n '1s/^worktree //p'; }
current_checkout() { git rev-parse --show-toplevel; }
worktrees_dir() { echo "${WT_DIR:-$(dirname "$(main_checkout)")/worktrees/$(basename "$(main_checkout)")}"; }

slug_for() {
  local slug
  slug=$(lower "$1" | sed -E 's/[^a-z0-9]+/_/g' | cut -c1-30)
  case "$slug" in
    development | snapshot | test*) die "branch '$1' would collide with a shared database name" ;;
  esac
  echo "$slug"
}

require_linked_worktree() {
  git rev-parse --git-dir > /dev/null 2>&1 || die "not in a git checkout"
  [ "$(current_checkout)" != "$(main_checkout)" ] || die "run this in a linked worktree, not the main checkout"
}

branch_of() { git -C "$1" symbolic-ref --quiet --short HEAD || true; }

path_for_branch() {
  git worktree list --porcelain | awk -v b="refs/heads/$1" '
    /^worktree / { path = substr($0, 10) }
    /^branch / && $2 == b { print path }'
}

# path<TAB>branch for every checkout, the main one first; branch is empty for a detached checkout
worktrees() {
  git -C "$(main_checkout)" worktree list --porcelain |
    awk '/^worktree /{path=substr($0,10); branch=""} /^branch /{branch=substr($0,19)} /^$/{print path "\t" branch}'
}

db_exists() { [ "$(psql -XAtc "select 1 from pg_database where datname = '$1'" postgres)" = 1 ]; }

# file_copy_method = clone (PostgreSQL 18+) makes the copy share the source's files through APFS clones.
# It is set for this session only, so the server's settings stay untouched. Older servers reject the
# SET, and psql still runs the CREATE as a full copy and reports its result.
copy_db() {
  psql -Xq -c "set file_copy_method = clone" \
    -c "create database \"$2\" template \"$1\" strategy file_copy" postgres 2> /dev/null
}

clone_db() {
  local source=$1 target=$2
  copy_db "$source" "$target" ||
    die "couldn't clone $source while it's in use. Stop the main checkout's server, worker, and console, run 'wt snapshot', then rerun 'wt setup'"
}

herdr_running() { command -v herdr-app > /dev/null 2>&1 && herdr-app ls > /dev/null 2>&1; }

json_array() { python3 -c 'import json, sys; print(json.dumps(sys.argv[1:]))' "$@"; }
json_field() { python3 -c 'import json, sys; print(json.load(sys.stdin).get(sys.argv[1]) or "")' "$1"; }

herdr_panes() {
  herdr-app ls | python3 -c '
import json, sys
for space in json.load(sys.stdin)["spaces"]:
    for tab in space["tabs"]:
        for t in tab["terminals"]:
            print(t["terminal"], t["pane"], space["id"], space["folder"], tab["id"], sep="\t")'
}
tab_of_terminal() { herdr_panes | awk -F'\t' -v t="$1" '$1 == t { print $5; exit }'; }
pane_of_terminal() { herdr_panes | awk -F'\t' -v t="$1" '$1 == t { print $2; exit }'; }
spaces_in_folder() { herdr_panes | awk -F'\t' -v f="$1" '$4 == f { print $3 }' | sort -u; }

agent_argv() {
  case "${WT_AGENT:-claude}" in
    claude) json_array claude --permission-mode auto --name "$@" ;;
    *) json_array "$WT_AGENT" ;;
  esac
}

# Claude keeps a checkout's conversations under its path with every other character turned into
# "-", so a checkout that had one picks up where it left off
resume_flag() {
  local sessions=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/$(echo "$1" | sed 's/[^A-Za-z0-9]/-/g')
  [ "${WT_AGENT:-claude}" = claude ] && compgen -G "$sessions/*.jsonl" > /dev/null && echo --continue
  return 0
}

# Agent on the left, a shell on the right, and $WT_EDITOR (if set) under the agent.
code_layout() {
  local pane=$1
  herdr-app do pane.split --direction right --pane "$pane" > /dev/null
  [ -z "${WT_EDITOR:-}" ] ||
    herdr-app do pane.split --direction down --pane "$pane" --argv "$(json_array sh -c "$WT_EDITOR")" > /dev/null
  herdr-app do pane.focus --pane "$pane" > /dev/null
}

# server: the command the server tab runs, or empty for no server tab. task: the agent's first message.
open_space() {
  local name=$1 folder=$2 argv=$3 server=${4:-} task=${5:-} made space tab
  if [ -n "$task" ]; then
    made=$(herdr-app do space.new --name "$name" --folder "$folder" --tab code --argv "$argv" --task "$task")
  else
    made=$(herdr-app do space.new --name "$name" --folder "$folder" --tab code --argv "$argv")
  fi
  space=$(echo "$made" | json_field space)
  tab=$(echo "$made" | json_field tab)
  code_layout "$(pane_of_terminal "$(echo "$made" | json_field terminal)")"
  if [ -n "$server" ]; then
    herdr-app do tab.new --name server --space "$space" --folder "$folder" \
      --argv "$(json_array sh -c "$server")" > /dev/null
    herdr-app do tab.select --id "$tab" > /dev/null
  fi
}

server_command() { if [ -f "$1/.env_overrides.rb" ]; then echo "wt serve"; else echo "wt setup && wt serve"; fi; }

# Herdr keys run a command in a new tab, which would otherwise linger as a shell. Listings and
# errors stay up until a key is pressed.
cmd_key() {
  local tab status
  tab=$(tab_of_terminal "${HC_TERMINAL_ID:-}")
  set +e
  (set -e; "cmd_$1" "${@:2}")
  status=$?
  set -e
  case "$1:$status" in
    ls:* | prune:* | *:[1-9]*) read -rsn1 -p "press any key" < /dev/tty || true ;;
  esac
  [ -z "$tab" ] || herdr-app do tab.close --id "$tab" --confirmed true > /dev/null
}

cmd_scratch() {
  herdr_running || die "Herdr isn't running"
  open_space scratch "$(main_checkout)" "$(agent_argv scratch)"
}

cmd_layout() {
  herdr_running || die "Herdr isn't running"
  [ -n "${HC_TERMINAL_ID:-}" ] || die "run this in a Herdr terminal"
  local pane name
  pane=$(pane_of_terminal "$HC_TERMINAL_ID")
  [ -n "$pane" ] || die "this terminal has no pane"
  name=$(branch_of "$(current_checkout)")
  code_layout "$pane"
  exec $(agent_argv "${name:-scratch}" | python3 -c 'import json, shlex, sys; print(shlex.join(json.load(sys.stdin)))')
}

ticket_of() { echo "$1" | sed -nE 's/^([A-Za-z]+-[0-9]+)-.+$/\1/p'; }

# Agent names must be short and unique, so use the ticket number when there is one
agent_name() {
  local ticket
  ticket=$(ticket_of "$1")
  echo "${ticket:-$1}"
}

# Linear's branch names carry the issue title, so "abc-2558-add-operating-hours" reads as
# "add operating hours"
space_label() {
  local ticket
  ticket=$(ticket_of "$1")
  if [ -n "$ticket" ]; then echo "${1#"$ticket"-}" | tr '-' ' '; else echo "$1"; fi
}

# Headless Claude reads Linear through the connector this account already has, so no API key
linear_branch() {
  echo "Looking up $1 in Linear..." >&2
  (cd "$HOME" && claude -p --model haiku --allowedTools mcp__claude_ai_Linear__get_issue --output-format json \
    "Use the Linear get_issue tool for $1. Reply with ONLY a JSON object {\"branch\": <its gitBranchName>} and nothing else." \
    < /dev/null 2> /dev/null) | jq -r '.result // empty' | grep -o '{.*}' | jq -r '.branch // empty'
}

# Turns what was typed into the branch, space label, agent name, and first message for cmd_new
resolve_target() {
  local target=$1 json number issue
  task=
  if [[ $target =~ ^(pr:|#)([0-9]+)$ ]]; then
    number=${BASH_REMATCH[2]}
    json=$(cd "$(main_checkout)" && gh pr view "$number" --json headRefName,title,isCrossRepository) ||
      die "couldn't find PR #$number"
    [ "$(jq -r .isCrossRepository <<< "$json")" = false ] || die "PR #$number comes from a fork"
    branch=$(jq -r .headRefName <<< "$json")
    label="PR $number: $(jq -r .title <<< "$json")"
    name="pr-$number"
    task=$(printf "$PR_PROMPT" "$number" "$number")
  elif [ -n "$TICKET_PREFIX" ] && [[ $(upper "$target") =~ ^$(upper "$TICKET_PREFIX")-[0-9]+$ ]]; then
    issue=$(upper "$target")
    branch=$(linear_branch "$issue")
    [ -n "$branch" ] || die "couldn't look up $issue in Linear; pass its branch name instead"
    label=$(space_label "$branch")
    name=$(agent_name "$branch")
    task=$(printf "$ISSUE_PROMPT" "$issue")
  else
    branch=$target
    label=$(space_label "$branch")
    name=$(agent_name "$branch")
  fi
}

# A branch someone already pushed (a teammate's ticket, a PR) is checked out rather than recreated
fetch_branch() {
  local main=$1 branch=$2
  git -C "$main" show-ref --verify --quiet "refs/heads/$branch" && return
  git -C "$main" ls-remote --exit-code --heads origin "$branch" > /dev/null 2>&1 || return 0
  git -C "$main" fetch --quiet origin "$branch:$branch"
  git -C "$main" branch --quiet --set-upstream-to "origin/$branch" "$branch"
}

# A branch that already has a worktree gets its open space shown, or a new space in which Claude
# continues its last conversation there
reopen() {
  local dir=$1 label=$2 name=$3 space
  herdr_running || { echo "$branch is already at $dir"; return; }
  space=$(spaces_in_folder "$dir" | head -1)
  if [ -n "$space" ]; then
    herdr-app do space.select --id "$space" > /dev/null
    echo "Switched to $branch's space"
    return
  fi
  open_space "$label" "$dir" "$(agent_argv "$name" $(resume_flag "$dir"))" "$(server_command "$dir")"
  echo "Reopened $dir"
}

cmd_new() {
  local target=${1:-} base=${2:-main} branch label name task main dir
  # readline (-e) understands bracketed paste; plain `read` keeps a paste's escape codes
  [ -n "$target" ] || [ ! -t 0 ] || read -erp "branch, ${TICKET_PREFIX:+$(upper "$TICKET_PREFIX")-1234, }or pr:1234: " target
  target=${target//$'\e[200~'/}
  target=${target//$'\e[201~'/}
  target=${target//[^A-Za-z0-9._\/:#-]/}
  [ -n "$target" ] || die "usage: wt new <branch|${TICKET_PREFIX:+$(upper "$TICKET_PREFIX")-1234|}pr:1234> [base]"
  resolve_target "$target"
  slug_for "$branch" > /dev/null
  main=$(main_checkout)

  dir=$(path_for_branch "$branch")
  if [ -n "$dir" ]; then
    [ "$dir" != "$main" ] || die "$branch is checked out in the main checkout; switch that to another branch first"
    reopen "$dir" "$label" "$name"
    return
  fi

  dir=$(worktrees_dir)/$branch
  [ ! -e "$dir" ] || die "$dir already exists"

  (cmd_gc) > /dev/null || echo "wt: couldn't drop unused databases; run wt gc to see why" >&2

  if [ "$base" = main ]; then
    say "Fetching main"
    git -C "$main" fetch origin main
    base=origin/main
  fi
  fetch_branch "$main" "$branch"

  mkdir -p "$(dirname "$dir")"
  if git -C "$main" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$main" worktree add "$dir" "$branch"
  else
    git -C "$main" worktree add --no-track -b "$branch" "$dir" "$base"
  fi

  if herdr_running; then
    open_space "$label" "$dir" "$(agent_argv "$name")" "$(server_command "$dir")" "$task"
  else
    (cd "$dir" && cmd_setup)
    echo
    echo "Worktree: $dir"
    echo "Next:     cd '$dir' && wt serve"
  fi
}

cmd_setup() {
  require_linked_worktree
  local main here branch slug dev_db test_db email exclude
  main=$(main_checkout)
  here=$(current_checkout)
  cd "$here"
  branch=$(branch_of "$here")
  [ -n "$branch" ] || die "this worktree has no branch (detached HEAD); check one out first"
  slug=$(slug_for "$branch")
  dev_db=${DB_PREFIX}_${slug}
  test_db=${DB_PREFIX}_test_${slug}
  email=${WT_AUTO_LOGIN_EMAIL:-$(git config user.email)}

  say "Linking credential keys"
  local key
  for key in "$main"/config/master.key "$main"/config/credentials/*.key; do
    [ -e "$key" ] || continue
    ln -sf "$key" "${key/#$main/$here}"
  done

  say "Writing .env_overrides.rb"
  {
    [ ! -e "$main/.env_overrides.rb" ] || echo "load '$main/.env_overrides.rb'"
    echo "ENV['DATABASE_NAME'] = '$dev_db'"
    echo "ENV['DATABASE_TEST_NAME'] = '$test_db'"
    echo "ENV['ADDITIONAL_HOST'] = '.$APP_NAME.localhost'"
    echo "ENV['WT_AUTO_LOGIN_EMAIL'] = '$email'"
  } > .env_overrides.rb

  say "Installing the auto-login initializer"
  cp "$AUTO_LOGIN_SOURCE" "$AUTO_LOGIN_TARGET"
  exclude=$(git rev-parse --git-common-dir)/info/exclude
  mkdir -p "$(dirname "$exclude")"
  grep -qxF "$AUTO_LOGIN_TARGET" "$exclude" 2> /dev/null || echo "$AUTO_LOGIN_TARGET" >> "$exclude"

  say "Initializing submodules"
  git submodule update --init --recursive

  say "Installing dependencies"
  local dir
  for dir in node_modules app/assets/builds; do
    if [ -d "$main/$dir" ] && [ -z "$(ls -A "$dir" 2> /dev/null | grep -v '^\.keep$')" ]; then
      mkdir -p "$dir"
      cp -cR "$main/$dir/" "$dir/"
    fi
  done
  bundle install --quiet
  yarn install --silent

  if db_exists "$dev_db"; then
    say "Database $dev_db already exists"
  elif db_exists "$SNAPSHOT_DB"; then
    say "Cloning $SNAPSHOT_DB to $dev_db"
    clone_db "$SNAPSHOT_DB" "$dev_db"
  else
    say "Cloning $DEV_DB to $dev_db (no snapshot yet)"
    clone_db "$DEV_DB" "$dev_db"
  fi

  say "Preparing databases"
  bin/rails db:migrate
  RAILS_ENV=test bin/rails db:prepare
  bin/rails parallel:create parallel:load_schema

  say "Ready: $(app_url)"
}

ensure_portless() {
  command -v portless > /dev/null 2>&1 && portless --version > /dev/null 2>&1 || npm install -g portless
}

app_url() { ensure_portless > /dev/null 2>&1 && portless get "$APP_NAME"; }

cmd_serve() {
  cd "$(current_checkout)"
  ensure_portless
  portless doctor 2>&1 | grep -q "Proxy is responding" ||
    echo "wt: the portless proxy isn't running; start it with 'sudo portless service install'" >&2
  gem list foreman -i --silent || gem install foreman
  exec foreman start -f Procfile.pdev "$@"
}

cmd_open() {
  cd "$(current_checkout)"
  open "$(app_url)"
}

cmd_review() {
  local base=${1:-main}
  cd "$(current_checkout)"
  exec codex --approve-for-me "$(printf "$REVIEW_PROMPT" "$base")"
}

# branch<TAB>number<TAB>state<TAB>head sha for recent PRs, newest first. State is OPEN, DRAFT,
# MERGED, or CLOSED.
pr_index() {
  (cd "$(main_checkout)" && gh pr list --state all --limit 300 --json number,state,isDraft,headRefName,headRefOid \
    --jq '.[] | [.headRefName, .number, (if .isDraft and .state == "OPEN" then "DRAFT" else .state end), .headRefOid] | @tsv')
}

# branch<TAB>pass|fail|running for open PRs. Asking for checks on every PR takes ten times as long.
ci_index() {
  (cd "$(main_checkout)" && gh pr list --state open --limit 100 --json headRefName,statusCheckRollup \
    --jq '.[] | [.headRefName, ((.statusCheckRollup // []) | map(.conclusion // .state // "") |
      if length == 0 then "-"
      elif any(.[]; . == "FAILURE" or . == "ERROR" or . == "TIMED_OUT" or . == "CANCELLED" or . == "ACTION_REQUIRED" or . == "STARTUP_FAILURE") then "fail"
      elif any(.[]; . == "" or . == "PENDING" or . == "EXPECTED") then "running"
      else "pass" end)] | @tsv')
}

row_for() { [ -n "$1" ] && awk -F'\t' -v b="$1" '$1 == b { print; exit }' <<< "$2"; }

cmd_ls() {
  local prs ci path branch pr number state pr_column checks changed counts unpushed age
  prs=$(pr_index)
  ci=$(ci_index)
  {
    printf 'WORKTREE\tPR\tCI\tCHANGED\tMAIN\tUNPUSHED\tLAST COMMIT\n'
    while IFS=$'\t' read -r path branch; do
      [ -d "$path" ] || continue
      pr_column=-
      if pr=$(row_for "$branch" "$prs") && [ -n "$pr" ]; then
        IFS=$'\t' read -r _ number state _ <<< "$pr"
        pr_column="#$number $(lower "$state")"
      fi
      checks=$(row_for "$branch" "$ci" | cut -f2) || true
      changed=$(git -C "$path" status --porcelain | wc -l | tr -d ' ')
      counts=$(git -C "$path" rev-list --left-right --count origin/main...HEAD 2> /dev/null) || counts="? ?"
      unpushed=$(git -C "$path" rev-list --count '@{u}..HEAD' 2> /dev/null) || unpushed="no upstream"
      age=$(git -C "$path" log -1 --format=%cr)
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${branch:-$(basename "$path") (detached)}" "$pr_column" \
        "${checks:--}" "$changed" "↓${counts%%[[:space:]]*} ↑${counts##*[[:space:]]}" "$unpushed" "$age"
    done < <(worktrees)
  } | column -t -s $'\t'
}

cmd_rm() {
  local force='' branch dir main
  if [ "${1:-}" = --force ]; then force=--force; shift; fi
  branch=${1:-}
  [ -n "$branch" ] || die "usage: wt rm [--force] <branch>"
  main=$(main_checkout)
  dir=$(path_for_branch "$branch")
  [ -n "$dir" ] || die "no linked worktree for $branch"
  [ "$dir" != "$main" ] || die "$branch is checked out in the main checkout"

  case "$PWD/" in "$dir"/*) die "you are inside $dir; run this from another checkout" ;; esac
  if [ -z "$force" ] && [ -n "$(git -C "$dir" status --porcelain)" ]; then
    die "$dir has uncommitted changes; use --force to remove it anyway"
  fi
  if herdr_running; then
    local space
    for space in $(spaces_in_folder "$dir"); do
      say "Closing its Herdr space"
      herdr-app do space.close --id "$space" --confirmed true > /dev/null
    done
  fi
  say "Removing $dir"
  # Initialized submodules block plain removal. set -e is off when the caller is `cmd_rm || ...`,
  # so a failed removal has to stop here before the databases are dropped.
  git -C "$main" worktree remove --force "$dir" || die "couldn't remove $dir"

  cmd_gc
  echo "Kept branch $branch."
}

# The main checkout's defaults (with their turbo_tests copies), the snapshot, and whatever each
# checkout's .env_overrides.rb names
live_db_names() {
  local paths path
  paths=$(git -C "$(main_checkout)" worktree list --porcelain | sed -n 's/^worktree //p')
  [ -n "$paths" ] || return 1
  printf '%s\n' "$DEV_DB" "${DB_PREFIX}_test" "$SNAPSHOT_DB"
  while read -r path; do
    sed -nE "s/^ENV\[['\"]DATABASE(_TEST)?_NAME['\"]\] *(\|\|)?= *['\"]([^'\"]+)['\"].*/\3/p" \
      "$path/.env_overrides.rb" 2> /dev/null || true
  done <<< "$paths"
}

# Removing a checkout from Herdr, from git, or from another tool skips `wt rm`, so this sweeps up
# after all of them. A name plus digits is one of turbo_tests' copies of that database.
cmd_gc() {
  local dry='' live db
  [ "${1:-}" = --dry-run ] && dry=1
  [ -n "$dry" ] || git -C "$(main_checkout)" worktree prune
  live=$(live_db_names) || die "couldn't list the checkouts, so no database is safe to drop"
  while read -r db; do
    [ -n "$db" ] || continue
    grep -qxF -e "$db" -e "${db%"${db##*[!0-9]}"}" <<< "$live" && continue
    if [ -n "$dry" ]; then
      echo "would drop $db"
    else
      psql -Xqc "drop database if exists \"$db\" with (force)" postgres && echo "Dropped $db"
    fi
  done < <(psql -XAtc "select datname from pg_database where datname like '${DB_PREFIX}\_%' order by 1" postgres)
}

# Why a branch's worktree can go, or nothing when it should stay. A merged PR counts only when the
# branch has nothing newer than what merged.
stale_reason() {
  local branch=$1 prs=$2 main pr number state head last_commit idle_days
  main=$(main_checkout)
  if pr=$(row_for "$branch" "$prs") && [ -n "$pr" ]; then
    IFS=$'\t' read -r _ number state head <<< "$pr"
    case $state in
      MERGED) git -C "$main" merge-base --is-ancestor "$branch" "$head" 2> /dev/null && echo merged ;;
      CLOSED) echo "PR #$number was closed without merging" ;;
    esac
    return 0
  fi
  last_commit=$(git -C "$main" log -1 --format=%ct "$branch")
  idle_days=$((($(date +%s) - last_commit) / 86400))
  [ "$idle_days" -lt "$IDLE_DAYS" ] || echo "it has no PR and no commits for $idle_days days"
}

# Reads the answer from the terminal, since prune's stdin is the worktree list
confirm() {
  local answer
  [ -t 2 ] || return 1
  read -rp "$1 [y/N] " answer < /dev/tty || return 1
  [[ $answer == [yY]* ]]
}

# gh stack keeps its own record of each stacked branch, so leave those for `gh stack sync` to retire
in_gh_stack() {
  grep -qF "\"$1\"" "$(git -C "$(main_checkout)" rev-parse --path-format=absolute --git-common-dir)/gh-stack" 2> /dev/null
}

delete_branch() {
  if in_gh_stack "$1"; then
    echo "Kept branch $1, which gh stack still tracks"
  else
    git -C "$(main_checkout)" branch -D --quiet "$1" && echo "Deleted branch $1"
  fi
}

cmd_prune() {
  local main prs path branch reason
  main=$(main_checkout)
  cd "$main"
  prs=$(pr_index)
  while IFS=$'\t' read -r path branch; do
    [ -n "$branch" ] && [ "$path" != "$main" ] || continue
    reason=$(stale_reason "$branch" "$prs")
    [ -n "$reason" ] || continue
    if [ -n "$(git -C "$path" status --porcelain --ignore-submodules=none)" ]; then
      echo "wt: kept $branch, which has uncommitted changes ($reason)" >&2
      continue
    fi
    if [ "$reason" = merged ]; then
      echo "$branch: its PR merged"
    else
      confirm "Remove the $branch worktree? $reason." || continue
    fi
    (cmd_rm --force "$branch") || { echo "wt: skipped $branch" >&2; continue; }
    [ "$reason" != merged ] || delete_branch "$branch"
  done < <(worktrees)

  while IFS=$'\t' read -r branch path; do
    [ -z "$path" ] && [ "$branch" != main ] || continue
    [ "$(stale_reason "$branch" "$prs")" != merged ] || delete_branch "$branch"
  done < <(git -C "$main" for-each-ref --format='%(refname:short)%09%(worktreepath)' refs/heads)

  cmd_gc
}

cmd_snapshot() {
  # Copy under a temporary name first, so a failed copy leaves the old snapshot in place.
  local fresh=${SNAPSHOT_DB}_new
  say "Refreshing $SNAPSHOT_DB from $DEV_DB"
  PGOPTIONS=--client-min-messages=warning psql -Xqc "drop database if exists \"$fresh\"" postgres
  copy_db "$DEV_DB" "$fresh" ||
    die "couldn't copy $DEV_DB while it's in use, so $SNAPSHOT_DB was left as it was. Stop the main checkout's server, worker, and console, then rerun 'wt snapshot'"
  PGOPTIONS=--client-min-messages=warning psql -Xqc "drop database if exists \"$SNAPSHOT_DB\"" postgres
  psql -Xqc "alter database \"$fresh\" rename to \"$SNAPSHOT_DB\"" postgres
  echo "Done."
}

usage() {
  cat << EOF
usage: wt <command>

  new [target] [base]     Create a worktree (base defaults to main) and its Herdr space. The target
                          is a branch, a Linear issue (ABC-1234: its branch, and the agent
                          starts by reading the issue), or a PR (pr:1234: its branch, and the agent
                          starts by reading the PR). A branch that already has a worktree gets its
                          open space shown, or a new one in which Claude continues its last conversation
  scratch                 Herdr space on the main checkout with the code layout and no server
  layout                  Turn the current Herdr pane into the code layout
  setup                   Bootstrap the current linked worktree
  serve                   Run the app (web via portless, js, worker)
  open                    Open this checkout's URL in the browser
  ls                      Every checkout with its PR, CI, uncommitted files, distance from main,
                          unpushed commits, and age
  review [base]           Start Codex reviewing this branch against base (default main), read-only
  rm [--force] <branch>   Close the space, remove the checkout, drop its databases; keeps the branch
  prune                   Remove clean worktrees whose PR merged and delete their branches; offer to
                          remove ones whose PR closed or that have no PR and sat idle for $IDLE_DAYS days;
                          delete branches without a worktree whose PR merged; then gc
  gc [--dry-run]          Drop every database no checkout uses, however its checkout was removed
  snapshot                Refresh the idle dev-database copy new worktrees clone from

  WT_AGENT=codex wt new|scratch|layout   Use Codex instead of Claude
EOF
}

command=${1:-}
[ $# -eq 0 ] || shift
case "$command" in
  key | new | scratch | layout | setup | serve | open | ls | review | rm | prune | gc | snapshot) "cmd_$command" "$@" ;;
  *) usage ;;
esac
